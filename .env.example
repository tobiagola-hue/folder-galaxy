# Copy this file to .env and adjust it:   cp .env.example .env

# The page can never leave this folder. It is mounted read-only into the container.
BROWSE_ROOT=/home/yourname

# Folder shown when the page opens (must be inside BROWSE_ROOT).
DEFAULT_ROOT=/home/yourname/projects

# Port on the host.
PORT=8765

# Seconds between checks (big folders are automatically checked less often).
SCAN_INTERVAL=3

# Safety limit on the number of items shown.
MAX_NODES=30000

# Extra names to ignore, comma separated, wildcards allowed. Example: data,backups,*.tmp
EXCLUDE_EXTRA=
